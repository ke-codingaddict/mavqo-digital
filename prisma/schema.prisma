// Mavqo Digital — database schema (spec §9).
// Products and services live in typed content files (src/content). Blog posts
// written in the admin are stored here (BlogPost) alongside the built-in
// articles in src/content/blog/posts.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EnquiryType {
  contact
  demo
  quote
  marketing
  waitlist
}

enum LeadStatus {
  new
  contacted
  qualified
  proposal_sent
  won
  lost
}

enum UserRole {
  admin
  sales
}

model Lead {
  id          String      @id @default(uuid()) @db.Uuid
  reference   String      @unique @db.VarChar(16)
  enquiryType EnquiryType @map("enquiry_type")
  status      LeadStatus  @default(new)

  name             String  @db.VarChar(160)
  email            String? @db.VarChar(254)
  phone            String? @db.VarChar(40)
  organization     String? @db.VarChar(200)
  preferredContact String? @map("preferred_contact") @db.VarChar(20)

  productInterest  String? @map("product_interest") @db.VarChar(80)
  serviceInterest  String? @map("service_interest") @db.VarChar(80)
  organizationSize String? @map("organization_size") @db.VarChar(40)
  websiteUrl       String? @map("website_url") @db.VarChar(300)
  objective        String? @db.VarChar(300)
  budgetRange      String? @map("budget_range") @db.VarChar(40)
  timeline         String? @db.VarChar(40)
  message          String? @db.Text

  // Attribution: which page and campaign produced this lead.
  sourcePage  String? @map("source_page") @db.VarChar(300)
  referrer    String? @db.VarChar(300)
  utmSource   String? @map("utm_source") @db.VarChar(100)
  utmMedium   String? @map("utm_medium") @db.VarChar(100)
  utmCampaign String? @map("utm_campaign") @db.VarChar(150)
  utmTerm     String? @map("utm_term") @db.VarChar(150)
  utmContent  String? @map("utm_content") @db.VarChar(150)
  gclid       String? @db.VarChar(200)

  // Salted hash only — the raw IP is never stored. Used for rate limiting.
  ipHash       String? @map("ip_hash") @db.VarChar(64)
  consentGiven Boolean @default(false) @map("consent_given")

  mailThreads MailThread[]

  internalNotes    String?   @map("internal_notes") @db.Text
  notifiedAt       DateTime? @map("notified_at") @db.Timestamptz
  firstContactedAt DateTime? @map("first_contacted_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status, createdAt])
  @@index([enquiryType, createdAt])
  @@index([ipHash, createdAt])
  @@map("leads")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(254)
  name         String    @db.VarChar(160)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         UserRole  @default(sales)
  active       Boolean   @default(true)
  failedLogins Int       @default(0) @map("failed_logins")
  lockedUntil  DateTime? @map("locked_until") @db.Timestamptz
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  /// Personal email signature (see src/lib/mail/signature.ts for the shape).
  signature Json?

  auditLogs       AuditLog[]
  sessions        AdminSession[]
  sentMail        MailMessage[]
  settingsChanged Setting[]
  blogPosts       BlogPost[]

  @@map("users")
}

/// Server-side record of each admin sign-in, so sessions can be revoked and
/// expire after inactivity regardless of what the browser holds.
model AdminSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  ipHash     String?   @map("ip_hash") @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String   @db.VarChar(60)
  entityType String?  @map("entity_type") @db.VarChar(40)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  metadata   Json?
  ipHash     String?  @map("ip_hash") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

/// Admin-editable configuration (mail provider, analytics IDs…). Secret values
/// inside `value` are encrypted at the application layer (src/lib/security/crypto.ts).
model Setting {
  key         String   @id @db.VarChar(60)
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("settings")
}

enum MailDirection {
  inbound
  outbound
}

enum MailCategory {
  received
  compose
  reply
  auto_reply
  account
  test
}

enum MailStatus {
  received
  sent
  failed
}

/// A conversation with one outside contact.
model MailThread {
  id                String    @id @default(uuid()) @db.Uuid
  subject           String    @db.VarChar(300)
  /// Subject without Re:/Fwd: prefixes, used to match replies.
  normalizedSubject String    @map("normalized_subject") @db.VarChar(300)
  contactEmail      String    @map("contact_email") @db.VarChar(254)
  contactName       String?   @map("contact_name") @db.VarChar(160)
  leadId            String?   @map("lead_id") @db.Uuid
  lead              Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  archivedAt        DateTime? @map("archived_at") @db.Timestamptz
  lastMessageAt     DateTime  @default(now()) @map("last_message_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  messages MailMessage[]

  @@index([lastMessageAt])
  @@index([contactEmail, normalizedSubject])
  @@map("mail_threads")
}

model MailMessage {
  id          String        @id @default(uuid()) @db.Uuid
  threadId    String        @map("thread_id") @db.Uuid
  thread      MailThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  direction   MailDirection
  category    MailCategory
  status      MailStatus
  fromAddress String        @map("from_address") @db.VarChar(254)
  fromName    String?       @map("from_name") @db.VarChar(200)
  to          String[]
  cc          String[]
  subject     String        @db.VarChar(300)
  text        String?       @db.Text
  html        String?       @db.Text
  /// RFC 5322 Message-ID, used to thread replies.
  messageId   String?       @unique @map("message_id") @db.VarChar(300)
  inReplyTo   String?       @map("in_reply_to") @db.VarChar(300)
  references  String[]
  /// Resend's email id (sent or received); unique so webhook retries are no-ops.
  resendId    String?       @unique @map("resend_id") @db.VarChar(64)
  attachments Json?
  error       String?       @db.VarChar(300)
  sentById    String?       @map("sent_by_id") @db.Uuid
  sentBy      User?         @relation(fields: [sentById], references: [id], onDelete: SetNull)
  readAt      DateTime?     @map("read_at") @db.Timestamptz
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@index([threadId, createdAt])
  @@index([direction, readAt])
  @@map("mail_messages")
}

/**
 * ------------------------------ Google Ads reporting ------------------------------
 */

/// A client's Google Ads account that Mavqo manages. Metrics are synced from
/// the Google Ads API (src/lib/google-ads/sync.ts) so reports never need a
/// Google sign-in and stay fast.
model AdsAccount {
  id            String    @id @default(uuid()) @db.Uuid
  /// Client / company name shown on dashboards and reports.
  name          String    @db.VarChar(160)
  /// Google Ads customer ID, digits only (123-456-7890 → 1234567890).
  customerId    String    @unique @map("customer_id") @db.VarChar(10)
  /// Account currency and time zone, read from Google Ads on each sync.
  currencyCode  String    @default("KES") @map("currency_code") @db.VarChar(3)
  timeZone      String?   @map("time_zone") @db.VarChar(60)
  /// Agreed monthly ad budget, in the account currency — used for pacing.
  monthlyBudget Decimal?  @map("monthly_budget") @db.Decimal(14, 2)
  active        Boolean   @default(true)
  /// Client logo for the dashboard and printable report (PNG, JPEG or WebP; ≤ 512 KB).
  logo          Bytes?
  logoType      String?   @map("logo_type") @db.VarChar(20)
  logoUpdatedAt DateTime? @map("logo_updated_at") @db.Timestamptz
  lastSyncedAt  DateTime? @map("last_synced_at") @db.Timestamptz
  lastSyncError String?   @map("last_sync_error") @db.VarChar(500)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  campaignDays   AdsCampaignDay[]
  conversionDays AdsConversionDay[]
  keywords       AdsKeyword[]

  @@map("ads_accounts")
}

/// One campaign's metrics on one day (account time zone).
model AdsCampaignDay {
  accountId             String     @map("account_id") @db.Uuid
  account               AdsAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date                  DateTime   @db.Date
  campaignId            String     @map("campaign_id") @db.VarChar(20)
  campaignName          String     @map("campaign_name") @db.VarChar(255)
  campaignStatus        String     @map("campaign_status") @db.VarChar(20)
  channelType           String     @map("channel_type") @db.VarChar(40)
  impressions           Int        @default(0)
  clicks                Int        @default(0)
  costMicros            BigInt     @default(0) @map("cost_micros")
  conversions           Float      @default(0)
  conversionsValue      Float      @default(0) @map("conversions_value")
  /// Search impression share metrics (0–1); null for non-search campaigns.
  searchImpressionShare Float?     @map("search_impression_share")
  budgetLostShare       Float?     @map("budget_lost_share")
  rankLostShare         Float?     @map("rank_lost_share")

  @@id([accountId, date, campaignId])
  @@map("ads_campaign_days")
}

/// Conversions per conversion action (calls, forms, purchases…) per day.
model AdsConversionDay {
  accountId   String     @map("account_id") @db.Uuid
  account     AdsAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date        DateTime   @db.Date
  campaignId  String     @map("campaign_id") @db.VarChar(20)
  actionName  String     @map("action_name") @db.VarChar(255)
  category    String     @db.VarChar(60)
  conversions Float      @default(0)
  value       Float      @default(0)

  @@id([accountId, date, campaignId, actionName])
  @@map("ads_conversion_days")
}

/// Keyword performance over the last 30 days, replaced on every sync.
model AdsKeyword {
  accountId    String     @map("account_id") @db.Uuid
  account      AdsAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  adGroupId    String     @map("ad_group_id") @db.VarChar(20)
  criterionId  String     @map("criterion_id") @db.VarChar(20)
  campaignName String     @map("campaign_name") @db.VarChar(255)
  adGroupName  String     @map("ad_group_name") @db.VarChar(255)
  text         String     @db.VarChar(255)
  matchType    String     @map("match_type") @db.VarChar(20)
  qualityScore Int?       @map("quality_score")
  impressions  Int        @default(0)
  clicks       Int        @default(0)
  costMicros   BigInt     @default(0) @map("cost_micros")
  conversions  Float      @default(0)

  @@id([accountId, adGroupId, criterionId])
  @@map("ads_keywords")
}

/**
 * ------------------------------------ Blog ------------------------------------
 */

/// An article written in the admin. Public pages read published posts through a
/// cached query (src/lib/blog/posts.ts) that is refreshed whenever a post is saved.
model BlogPost {
  id             String    @id @default(uuid()) @db.Uuid
  slug           String    @unique @db.VarChar(100)
  title          String    @db.VarChar(160)
  excerpt        String    @db.VarChar(320)
  category       String    @db.VarChar(60)
  /// Article text in the lightweight format parsed by src/lib/blog/markdown.ts.
  body           String    @db.Text
  author         String    @db.VarChar(120)
  seoTitle       String    @map("seo_title") @db.VarChar(70)
  seoDescription String    @map("seo_description") @db.VarChar(170)
  /// Call-to-action button at the end of the article (internal path).
  ctaLabel       String    @map("cta_label") @db.VarChar(80)
  ctaHref        String    @map("cta_href") @db.VarChar(200)

  /// Cover photo: either a site image (/images/…) or an uploaded file below.
  imageSrc       String?   @map("image_src") @db.VarChar(200)
  imageAlt       String    @map("image_alt") @db.VarChar(200)
  /// Uploaded cover (PNG, JPEG or WebP; ≤ 4 MB), served by /media/blog/[file].
  image          Bytes?
  imageType      String?   @map("image_type") @db.VarChar(20)
  imageUpdatedAt DateTime? @map("image_updated_at") @db.Timestamptz

  published      Boolean   @default(false)
  publishedAt    DateTime? @map("published_at") @db.Date
  createdById    String?   @map("created_by_id") @db.Uuid
  createdBy      User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([published, publishedAt])
  @@map("blog_posts")
}
