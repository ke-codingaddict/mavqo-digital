# ─────────────────────────────────────────────────────────────
# Mavqo Digital — environment variables
# Copy to .env for local development. Never commit real values.
# ─────────────────────────────────────────────────────────────

# "development" | "staging" | "production"
# Only "production" allows search engines to index the site.
APP_ENV="development"

# Canonical public URL (https in production), e.g. https://mavqodigital.co.ke
APP_BASE_URL="http://localhost:3000"

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/mavqo_digital?schema=public"

# Session signing secret (≥32 chars). Generate: openssl rand -base64 48
AUTH_SECRET=""

# Salt for hashing visitor IPs (rate limiting). Generate: openssl rand -hex 24
IP_HASH_SALT=""

# Encrypts secrets saved from Admin → Settings (≥32 chars). Generate: openssl rand -base64 48
# Keep it stable: changing it makes saved secrets unreadable (re-enter them in the admin).
SETTINGS_ENCRYPTION_KEY=""

# How many reverse proxies sit in front of the app and append to
# X-Forwarded-For (Vercel, or a single nginx/Caddy = 1; Cloudflare in front of
# nginx = 2). The client IP is read that many entries from the right, so it
# can't be forged by a client-supplied header. Rate limits depend on this.
TRUSTED_PROXY_HOPS="1"

# ── Email (Resend — https://resend.com) ───────────────────────
# Configure this in Admin → Settings → Email. These variables are only a
# fallback used when nothing has been saved there.
RESEND_API_KEY=""
# Must be a sender on a domain you've verified with Resend
EMAIL_FROM="Mavqo Digital <leads@your-verified-domain>"
# Comma-separated list of team inboxes to notify
LEAD_NOTIFICATION_EMAIL=""

# ── Analytics & advertising (optional) ───────────────────────
# Configure these in Admin → Settings → Analytics & SEO; variables are a fallback.
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
# Google Ads conversion ID, e.g. AW-123456789
NEXT_PUBLIC_GOOGLE_ADS_ID=""
# Google Search Console HTML-tag verification token
GOOGLE_SITE_VERIFICATION=""

# ── Google Ads reporting (Admin → Google Ads) ─────────────────
# API details and the Google sign-in are saved in Admin → Settings → Google Ads.
# Google Ads API version used in request URLs (check Google's release notes; versions sunset after ~1 year).
GOOGLE_ADS_API_VERSION="v25"
# Protects the daily sync endpoint (/api/cron/google-ads-sync/). Vercel Cron sends it automatically.
# Generate: openssl rand -hex 24. Without it the daily sync is off (manual "Sync" still works).
CRON_SECRET=""
